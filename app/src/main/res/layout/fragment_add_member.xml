<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/memberScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f0f0f0"
    android:layoutDirection="rtl">

    <LinearLayout
        android:id="@+id/memberFormLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@android:color/white"
        android:padding="16dp"
        android:elevation="4dp">

        <!-- ===== عنوان ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="إضافة فرد للعائلة"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#000"
            android:layout_marginBottom="12dp" />

        <!-- ===== بيانات الفرد ===== -->
        <EditText
            android:id="@+id/etMemberName"
            android:layout_width="match_parent"
            style="@style/CustomEditText"
            android:layout_height="wrap_content"
            android:hint="الاسم الرباعي" />

        <EditText
            style="@style/CustomEditText"
            android:id="@+id/etMemberNationalId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="رقم الهوية"
            android:inputType="number" />

        <EditText
            android:id="@+id/etMemberBirthdate"
            android:layout_width="match_parent"
            style="@style/CustomEditText"
            android:layout_height="wrap_content"
            android:hint="تاريخ الميلاد"
            android:focusable="false"
            android:clickable="true" />

        <EditText
            android:id="@+id/etMemberPhone"
            android:layout_width="match_parent"
            style="@style/CustomEditText"
            android:layout_height="wrap_content"
            android:hint="رقم الجوال" />

        <EditText
            android:id="@+id/etMemberEducation"
            android:layout_width="match_parent"
            style="@style/CustomEditText"
            android:layout_height="wrap_content"
            android:hint="المستوى التعليمي" />

        <!-- ===== الجنس ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="الجنس"
            android:textSize="16sp"
            android:textColor="#000"
            android:layout_marginTop="12dp" />

        <RadioGroup
            android:id="@+id/genderRadioGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <RadioButton
                android:id="@+id/radioMale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ذكر" />

            <RadioButton
                android:id="@+id/radioFemale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="أنثى" />
        </RadioGroup>

        <!-- ===== الحالات الخاصة ===== -->
        <CheckBox
            android:id="@+id/checkIsSick"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="مريض" />

        <EditText
            android:id="@+id/etDisease"
            style="@style/CustomEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="نوع المرض (إن وجد)" />

        <CheckBox
            android:id="@+id/checkIsInjured"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="جريح" />

        <EditText
            android:id="@+id/etInjured"
            style="@style/CustomEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="تفاصيل الإصابة (إن وجد)" />

        <CheckBox
            android:id="@+id/checkIsMartyr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="شهيد" />

        <CheckBox
            android:id="@+id/checkIsPrisoner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="أسير" />

        <CheckBox
            android:id="@+id/checkIsOrphan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="يتيم" />

        <!-- زر الحفظ -->
        <Button
            android:id="@+id/btnSaveMember"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="حفظ الفرد"
            android:layout_marginTop="24dp"
            android:backgroundTint="#2196F3"
            android:textColor="@android:color/white" />

    </LinearLayout>
</ScrollView>
